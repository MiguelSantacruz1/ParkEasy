-- Pisos. El borrado es lógico: la columna deleted oculta el piso pero conserva el historial.
CREATE TABLE Floor (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    sortOrder INTEGER NOT NULL,
    canvasWidth REAL NOT NULL,
    canvasHeight REAL NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

selectActive:
SELECT id, name, sortOrder, canvasWidth, canvasHeight
FROM Floor
WHERE deleted = 0
ORDER BY sortOrder, id;

selectById:
SELECT id, name, sortOrder, canvasWidth, canvasHeight
FROM Floor
WHERE id = ? AND deleted = 0;

insert:
INSERT INTO Floor(name, sortOrder, canvasWidth, canvasHeight) VALUES (?, ?, ?, ?);

update:
UPDATE Floor SET name = ?, sortOrder = ?, canvasWidth = ?, canvasHeight = ? WHERE id = ?;

softDelete:
UPDATE Floor SET deleted = 1 WHERE id = ?;

lastInsertId:
SELECT last_insert_rowid();
