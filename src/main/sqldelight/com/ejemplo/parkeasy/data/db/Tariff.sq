-- Una tarifa por tipo de vehículo, en pesos colombianos sin decimales.
CREATE TABLE Tariff (
    vehicleType TEXT NOT NULL PRIMARY KEY,
    firstHour INTEGER NOT NULL,
    extraHour INTEGER NOT NULL,
    graceMinutes INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM Tariff ORDER BY vehicleType;

selectByType:
SELECT * FROM Tariff WHERE vehicleType = ?;

insertIfAbsent:
INSERT OR IGNORE INTO Tariff(vehicleType, firstHour, extraHour, graceMinutes) VALUES (?, ?, ?, ?);

upsert:
INSERT OR REPLACE INTO Tariff(vehicleType, firstHour, extraHour, graceMinutes) VALUES (?, ?, ?, ?);
